@model IReadOnlyList<Student>
@{
    ViewData["Title"] = "Students";
    var search = ViewData["Search"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="mb-1">Students</h1>
        <p class="text-muted mb-0">
            Manage student records. Data is stored in memory until Supabase is connected.
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add student</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="search" value="@search" class="form-control"
               placeholder="Search by name, email or course" aria-label="Search students" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <p class="mb-2">No students found@(string.IsNullOrWhiteSpace(search) ? "." : $" for \"{search}\".")</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Add the first student</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Full name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Course</th>
                            <th scope="col">Enrolled</th>
                            <th scope="col" class="text-center">GPA</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@student.FullName</td>
                                <td><a href="mailto:@student.Email">@student.Email</a></td>
                                <td>@student.Course</td>
                                <td>@student.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">
                                    @if (student.Gpa.HasValue)
                                    {
                                        <span class="badge rounded-pill @(student.Gpa >= 3.5m ? "text-bg-success" : student.Gpa >= 2.5m ? "text-bg-primary" : "text-bg-warning")">
                                            @student.Gpa.Value.ToString("0.00")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.Count > 0)
    {
        <div class="card-footer text-muted small">
            @Model.Count student@(Model.Count == 1 ? "" : "s")
        </div>
    }
</div>
