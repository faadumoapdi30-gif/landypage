@model Student
@{
    ViewData["Title"] = "Delete student";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Delete student</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="card border-danger shadow-sm">
    <div class="card-body">
        <h2 class="h5 text-danger">Are you sure you want to delete this student?</h2>
        <p class="text-muted">This action cannot be undone.</p>

        <dl class="row mb-4">
            <dt class="col-sm-3">Full name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Course</dt>
            <dd class="col-sm-9">@Model.Course</dd>

            <dt class="col-sm-3">Enrollment date</dt>
            <dd class="col-sm-9">@Model.EnrollmentDate.ToString("dd MMM yyyy")</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
