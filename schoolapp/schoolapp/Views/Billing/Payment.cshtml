@model PaymentInput
@{
    ViewData["Title"] = "Record payment";
    var invoice = (Invoice)ViewBag.Invoice;
}
<div class="page-heading"><div><p class="page-eyebrow">FINANCE WORKSPACE · INV-@invoice.Id.ToString("D6")</p><h1>Record payment</h1><p>Record a payment entry and update the invoice balance.</p></div></div>
<section class="hms-panel form-card">
    <div class="detail-grid" style="margin-bottom:20px">
        <div class="detail-item"><span>Patient</span><strong>@invoice.Patient.FullName</strong></div>
        <div class="detail-item"><span>Invoice total</span><strong>@invoice.TotalAmount.ToString("N2")</strong></div>
        <div class="detail-item"><span>Paid to date</span><strong>@invoice.PaidAmount.ToString("N2")</strong></div>
        <div class="detail-item"><span>Outstanding balance</span><strong>@((invoice.TotalAmount - invoice.PaidAmount).ToString("N2"))</strong></div>
    </div>
    <form asp-action="Payment" asp-route-id="@invoice.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div class="form-grid">
            <div class="form-field"><label asp-for="Amount" class="form-label">Payment amount</label><input asp-for="Amount" type="number" min="0.01" step="0.01" max="@((invoice.TotalAmount - invoice.PaidAmount).ToString("0.00"))" /><span asp-validation-for="Amount" class="field-validation-error"></span></div>
            <div class="form-field"><label asp-for="Method" class="form-label">Payment method</label><select asp-for="Method"><option>Cash</option><option>Card terminal</option><option>Bank transfer</option><option>Insurance</option></select><span asp-validation-for="Method" class="field-validation-error"></span></div>
            <div class="form-field full-width"><label asp-for="Reference" class="form-label">Reference (optional)</label><input asp-for="Reference" placeholder="Approved receipt or transaction reference" /><span asp-validation-for="Reference" class="field-validation-error"></span></div>
        </div>
        <div class="security-note">Do not enter or store card numbers, security codes or online banking credentials in this system.</div>
        <div class="form-actions"><button class="btn-hms" type="submit">Save payment</button><a class="btn-hms-secondary" asp-action="Index">Cancel</a></div>
    </form>
</section>
