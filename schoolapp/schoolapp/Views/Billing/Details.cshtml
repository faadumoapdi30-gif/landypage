@model Invoice
@{
    ViewData["Title"] = "Invoice and payment history";
    var balance = Model.TotalAmount - Model.PaidAmount;
}
<div class="page-heading">
    <div><p class="page-eyebrow">FINANCE WORKSPACE · INV-@Model.Id.ToString("D6")</p><h1>Invoice &amp; payment history</h1><p>@Model.Description</p></div>
    <div class="page-actions">@if (balance > 0) { <a class="btn-hms" asp-action="Payment" asp-route-id="@Model.Id">＋ Record payment</a> }<a class="btn-hms-secondary" asp-action="Index">Back to billing</a></div>
</div>
<section class="hms-panel">
    <div class="panel-heading"><h2>Invoice summary</h2><span class="status-pill status-@Model.Status.ToLowerInvariant().Replace(' ', '-')">@Model.Status</span></div>
    <div class="detail-grid">
        <div class="detail-item"><span>Patient</span><strong>@Model.Patient.FullName</strong></div>
        <div class="detail-item"><span>Patient number</span><strong>@Model.Patient.PatientNumber</strong></div>
        <div class="detail-item"><span>Issued</span><strong>@Model.IssuedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</strong></div>
        <div class="detail-item"><span>Invoice total</span><strong>@Model.TotalAmount.ToString("N2")</strong></div>
        <div class="detail-item"><span>Payments received</span><strong>@Model.PaidAmount.ToString("N2")</strong></div>
        <div class="detail-item"><span>Outstanding balance</span><strong>@balance.ToString("N2")</strong></div>
    </div>
</section>
<section class="hms-panel">
    <div class="panel-heading"><h2>Payment history</h2><span class="status-pill">@Model.Payments.Count transaction(s)</span></div>
    @if (Model.Payments.Count == 0) { <div class="empty-state"><strong>No payments recorded</strong><p>Payment transactions will appear here as they are saved.</p></div> }
    else
    {
        <div class="table-wrap"><table class="hms-table"><thead><tr><th>Date &amp; time</th><th>Method</th><th>Reference</th><th>Amount</th><th>Transaction</th></tr></thead><tbody>
        @foreach (var payment in Model.Payments.OrderByDescending(item => item.PaidAtUtc))
        {
            <tr><td>@payment.PaidAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td><td>@payment.Method</td><td>@(string.IsNullOrWhiteSpace(payment.Reference) ? "—" : payment.Reference)</td><td class="table-primary">@payment.Amount.ToString("N2")</td><td>#@payment.Id</td></tr>
        }
        </tbody></table></div>
    }
</section>
