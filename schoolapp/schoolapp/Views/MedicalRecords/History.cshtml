@model IReadOnlyList<MedicalRecord>
@{
    var patient = (Patient)ViewBag.Patient;
    ViewData["Title"] = "Medical history";
}
<div class="page-heading">
    <div><p class="page-eyebrow">CONFIDENTIAL CLINICAL HISTORY · @patient.PatientNumber</p><h1>@patient.FullName</h1><p>Consultation history visible only to authorized clinical staff.</p></div>
    <div class="page-actions"><a class="btn-hms-secondary" asp-controller="Patients" asp-action="Details" asp-route-id="@patient.Id">Patient profile</a><a class="btn-hms" asp-action="Create">＋ Record consultation</a></div>
</div>
<div class="database-notice"><strong>Confidential clinical information</strong><p>Access to this history is recorded. Open patient records only when required for an authorized work duty.</p></div>
<section class="hms-panel">
    <div class="table-wrap">
        <table class="hms-table"><thead><tr><th>Date</th><th>Doctor</th><th>Appointment</th><th>Consultation notes</th><th>Action</th></tr></thead><tbody>
        @foreach (var record in Model)
        {
            <tr><td>@record.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td><td>@record.Doctor.FullName<span class="table-secondary">@record.Doctor.Specialty</span></td><td>@(record.AppointmentId.HasValue ? "#" + record.AppointmentId : "Consultation")</td><td>@(record.Notes.Length > 90 ? record.Notes[..90] + "…" : record.Notes)</td><td><a class="btn-hms-secondary btn-small" asp-action="Details" asp-route-id="@record.Id">Open</a></td></tr>
        }
        </tbody></table>
        @if (Model.Count == 0) { <div class="empty-state"><strong>No consultation history recorded</strong><p>Consultations for this patient will appear here.</p></div> }
    </div>
</section>
