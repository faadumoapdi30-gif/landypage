@model AppointmentInput
@{
    ViewData["Title"] = "Edit appointment";
}
<div class="page-heading"><div><p class="page-eyebrow">SCHEDULE &amp; VISITS</p><h1>Reschedule appointment</h1><p>Only scheduled visits can be rescheduled.</p></div></div>
<section class="hms-panel form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        @await Html.PartialAsync("_AppointmentForm", Model)
        <div class="form-actions"><button class="btn-hms" type="submit">Save appointment</button><a class="btn-hms-secondary" asp-action="Index">Cancel</a></div>
    </form>
</section>
