@model IReadOnlyList<Doctor>
@{
    ViewData["Title"] = "Doctors";
    var canManageDoctors = User.IsInRole(StaffRoles.Admin);
}
<div class="page-heading">
    <div><p class="page-eyebrow">CARE TEAM</p><h1>Doctor directory</h1><p>View specialties and directory status for the care team.</p></div>
    @if (canManageDoctors) { <div class="page-actions"><a class="btn-hms" asp-action="Create">＋ Add doctor</a></div> }
</div>
<section class="hms-panel">
    <form class="filter-bar" method="get" asp-action="Index">
        <div class="form-field"><label class="form-label" for="search">Search doctors</label><input id="search" name="search" value="@ViewBag.Search" placeholder="Name, specialty or email" /></div>
        <button class="btn-hms-secondary" type="submit">Search</button>
        @if (ViewBag.Search is not null) { <a class="btn-hms-secondary" asp-action="Index">Clear</a> }
    </form>
    <div class="table-wrap">
        <table class="hms-table"><thead><tr><th>Doctor</th><th>Specialty</th><th>Contact</th><th>Linked login</th><th>Status</th>@if (canManageDoctors) { <th>Action</th> }</tr></thead><tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td><span class="table-primary">@doctor.FullName</span><span class="table-secondary">@(string.IsNullOrWhiteSpace(doctor.LicenseReference) ? "Professional reference not listed" : doctor.LicenseReference)</span></td>
                <td>@doctor.Specialty</td>
                <td>@(string.IsNullOrWhiteSpace(doctor.Phone) ? "—" : doctor.Phone)<span class="table-secondary">@doctor.Email</span></td>
                <td>@(doctor.StaffUser?.Email ?? "Not linked")</td>
                <td><span class="status-pill @(doctor.IsActive ? "status-active" : "status-inactive")">@(doctor.IsActive ? "Active" : "Inactive")</span></td>
                @if (canManageDoctors) { <td><div class="page-actions"><a class="btn-hms btn-small" asp-action="Edit" asp-route-id="@doctor.Id" aria-label="Edit @doctor.FullName">Edit</a>
                    <form asp-action="Delete" asp-route-id="@doctor.Id" method="post" data-confirm="Permanently delete this doctor profile? Profiles with visit history must be deactivated instead.">
                        @Html.AntiForgeryToken()
                        <button class="btn-hms-danger btn-small" type="submit">Delete</button>
                    </form></div></td> }
            </tr>
        }
        </tbody></table>
        @if (Model.Count == 0) { <div class="empty-state"><strong>No doctor profiles yet</strong><p>An administrator can add a doctor profile and link an approved staff account.</p></div> }
    </div>
</section>
