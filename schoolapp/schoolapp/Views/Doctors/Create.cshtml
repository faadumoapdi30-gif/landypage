@model DoctorInput
@{
    ViewData["Title"] = "Add doctor";
}
<div class="page-heading"><div><p class="page-eyebrow">CARE TEAM</p><h1>Add doctor</h1><p>Create a directory profile. Link a doctor login only when the staff account is ready.</p></div></div>
<section class="hms-panel form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        @await Html.PartialAsync("_DoctorForm", Model)
        <div class="form-actions"><button class="btn-hms" type="submit">Save doctor</button><a class="btn-hms-secondary" asp-action="Index">Cancel</a></div>
    </form>
</section>
