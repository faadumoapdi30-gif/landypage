@model IReadOnlyList<Patient>
@{
    ViewData["Title"] = "Patients";
    var canManagePatients = User.IsInRole(StaffRoles.Admin) || User.IsInRole(StaffRoles.Receptionist);
}
<div class="page-heading">
    <div><p class="page-eyebrow">PATIENT SERVICES</p><h1>Patients</h1><p>Search and manage patient profiles. Only view information needed for your role.</p></div>
    @if (canManagePatients) { <div class="page-actions"><a class="btn-hms" asp-action="Create">＋ Register patient</a></div> }
</div>
<section class="hms-panel">
    <form class="filter-bar" method="get" asp-action="Index">
        <div class="form-field"><label class="form-label" for="search">Search patients</label><input id="search" name="search" value="@ViewBag.Search" placeholder="Name, patient number or phone" /></div>
        <button class="btn-hms-secondary" type="submit">Search</button>
        @if (ViewBag.Search is not null) { <a class="btn-hms-secondary" asp-action="Index">Clear</a> }
    </form>
    <div class="table-wrap">
        <table class="hms-table">
            <thead><tr><th>Patient</th><th>Contact</th><th>Date of birth</th><th>Registered</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td><span class="table-primary">@patient.FullName</span><span class="table-secondary">@patient.PatientNumber</span></td>
                    <td>@(string.IsNullOrWhiteSpace(patient.Phone) ? "—" : patient.Phone)<span class="table-secondary">@patient.Email</span></td>
                    <td>@(patient.DateOfBirth == default ? "—" : patient.DateOfBirth.ToString("MMM d, yyyy"))</td>
                    <td>@patient.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                    <td><div class="page-actions"><a class="btn-hms-secondary btn-small" asp-action="Details" asp-route-id="@patient.Id">View</a>
                    @if (canManagePatients) { <a class="btn-hms btn-small" asp-action="Edit" asp-route-id="@patient.Id" aria-label="Edit @patient.FullName">Edit</a> }</div></td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Count == 0) { <div class="empty-state"><strong>No patient profiles found</strong><p>Try a different search or register a new patient.</p></div> }
    </div>
</section>
