@model Patient
@{
    ViewData["Title"] = "Edit patient";
}
<div class="page-heading"><div><p class="page-eyebrow">PATIENT SERVICES · @Model.PatientNumber</p><h1>Edit patient profile</h1><p>Update demographic and contact details. Changes are recorded for accountability.</p></div></div>
<section class="hms-panel form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="PatientNumber" type="hidden" />
        <input asp-for="CreatedAtUtc" type="hidden" />
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        @await Html.PartialAsync("_PatientForm", Model)
        <div class="form-actions"><button class="btn-hms" type="submit">Save changes</button><a class="btn-hms-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div>
    </form>
    <div class="form-actions">
        <form asp-action="Archive" asp-route-id="@Model.Id" method="post" data-confirm="Archive this patient profile? Historical appointments and records will be retained.">
            @Html.AntiForgeryToken()
            <button class="btn-hms-secondary" type="submit">Archive patient</button>
        </form>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Permanently delete this patient record? Deletion is allowed only when it has no appointments, clinical records or invoices.">
            @Html.AntiForgeryToken()
            <button class="btn-hms-danger" type="submit">Delete patient</button>
        </form>
    </div>
</section>
