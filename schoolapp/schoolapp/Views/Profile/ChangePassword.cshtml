@model ChangePasswordInput
@{
    ViewData["Title"] = "Change password";
}
<div class="page-heading"><div><p class="page-eyebrow">MY ACCOUNT</p><h1>Change password</h1><p>Choose a unique password with at least 12 characters.</p></div></div>
<section class="hms-panel form-card">
    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div class="form-grid">
            <div class="form-field full-width"><label asp-for="CurrentPassword" class="form-label">Current password</label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="field-validation-error"></span></div>
            <div class="form-field"><label asp-for="NewPassword" class="form-label">New password</label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="field-validation-error"></span></div>
            <div class="form-field"><label asp-for="ConfirmPassword" class="form-label">Confirm new password</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-validation-error"></span></div>
        </div>
        <div class="form-actions"><button class="btn-hms" type="submit">Update password</button><a class="btn-hms-secondary" asp-controller="Dashboard" asp-action="Index">Cancel</a></div>
    </form>
</section>
