@model StaffSetupInput
@{
    ViewData["Title"] = "First-time setup";
}

<section class="auth-card">
    <div class="auth-icon" aria-hidden="true">✚</div>
    <p class="page-eyebrow">SECURE FIRST-TIME SETUP</p>
    <h1>Create the administrator</h1>
    <p>This one-time setup is available only while no staff account exists.</p>
    @if (ViewBag.SetupError is string setupError)
    {
        <div class="alert alert-warning" role="alert">@setupError</div>
    }
    @if (ViewBag.DatabaseConfigured is not true)
    {
        <div class="database-notice">
            <strong>Configure PostgreSQL to continue</strong>
            <p>Set the connection string in local .NET user-secrets. Do not put database credentials in source files.</p>
            <code>dotnet user-secrets set "ConnectionStrings:Supabase" "&lt;your PostgreSQL connection string&gt;"</code>
            <p>Then create the schema with <code>dotnet ef database update</code>.</p>
        </div>
    }
    <form asp-action="Setup" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div class="form-field">
            <label asp-for="FullName" class="form-label">Administrator name</label>
            <input asp-for="FullName" autocomplete="name" placeholder="Full name" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>
        </div>
        <div class="form-field" style="margin-top:12px">
            <label asp-for="Email" class="form-label">Work email</label>
            <input asp-for="Email" autocomplete="email" placeholder="admin@hospital.org" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div class="form-field" style="margin-top:12px">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" autocomplete="new-password" placeholder="At least 12 characters" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="form-field" style="margin-top:12px">
            <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Enter password again" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
        <button class="btn-hms" type="submit">Create administrator account</button>
    </form>
    <p class="security-note">Use a unique, strong password. The system stores a password hash, not the original password.</p>
    <p class="auth-switch">Already set up? <a asp-action="Login">Staff sign in</a></p>
</section>
