@{
    ViewData["Title"] = "Learn at your own pace";
}

<main>
    <section class="hero" id="home">
        <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot"></span> A little progress, every day</p>
            <h1>Make room for<br />your <span>next thing.</span></h1>
            <p class="hero-description">
                Good things happen when curiosity has somewhere to go.
                Find a course you love and learn at your own pace.
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="#courses">Explore courses <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="#about">How it works <span aria-hidden="true">↓</span></a>
            </div>
            <div class="learner-note">
                <div class="avatar-stack" aria-hidden="true">
                    <span class="avatar avatar-one">J</span>
                    <span class="avatar avatar-two">M</span>
                    <span class="avatar avatar-three">A</span>
                    <span class="avatar avatar-four">+</span>
                </div>
                <p><strong>A good place to start.</strong><br />For the curious, wherever you are.</p>
            </div>
        </div>

        <div class="hero-art" aria-label="Illustration of books and a growing plant" role="img">
            <div class="art-sun"></div>
            <div class="art-note note-top"><span>✳</span> learn something new</div>
            <div class="art-plant">
                <span class="leaf leaf-one"></span>
                <span class="leaf leaf-two"></span>
                <span class="leaf leaf-three"></span>
                <span class="leaf leaf-four"></span>
                <span class="plant-stem"></span>
                <span class="plant-pot"></span>
            </div>
            <div class="book book-back"></div>
            <div class="book book-middle"></div>
            <div class="book book-front">
                <span class="book-spark">✳</span>
                <span>little by<br />little</span>
            </div>
            <div class="art-note note-bottom"><span>↗</span> your pace, your path</div>
        </div>
    </section>

    <section class="course-section" id="courses">
        <div class="section-heading">
            <div>
                <p class="eyebrow">A good place to begin</p>
                <h2>Follow what <span>feels interesting.</span></h2>
            </div>
            <p class="section-intro">A few paths to spark an idea.<br />Pick one, or just have a look around.</p>
        </div>

        <div class="course-grid">
            <article class="course-card course-creative">
                <div class="course-icon" aria-hidden="true">✳</div>
                <p class="course-label">MAKE & CREATE</p>
                <h3>Creative thinking</h3>
                <p>Make space for new ideas and find your own way to bring them to life.</p>
                <a href="#about" class="course-link" aria-label="Learn about creative thinking">Explore <span aria-hidden="true">↗</span></a>
            </article>
            <article class="course-card course-digital">
                <div class="course-icon" aria-hidden="true">&lt;/&gt;</div>
                <p class="course-label">DIGITAL SKILLS</p>
                <h3>Web & technology</h3>
                <p>Get comfortable with the tools and ideas shaping our digital world.</p>
                <a href="#about" class="course-link" aria-label="Learn about web and technology">Explore <span aria-hidden="true">↗</span></a>
            </article>
            <article class="course-card course-wellbeing">
                <div class="course-icon" aria-hidden="true">☼</div>
                <p class="course-label">LIFE & WELLBEING</p>
                <h3>Everyday growth</h3>
                <p>Small, thoughtful lessons to help you feel good about what comes next.</p>
                <a href="#about" class="course-link" aria-label="Learn about everyday growth">Explore <span aria-hidden="true">↗</span></a>
            </article>
        </div>
    </section>

    <section class="about-section" id="about">
        <div class="about-mark" aria-hidden="true">
            <span class="mark-circle mark-circle-one"></span>
            <span class="mark-circle mark-circle-two"></span>
            <span class="mark-spark">✳</span>
        </div>
        <div class="about-copy">
            <p class="eyebrow">Learning, made lighter</p>
            <h2>No rush.<br />Just <span>keep growing.</span></h2>
            <p>Learning doesn't have to be a big leap. Start with a small step, follow your curiosity, and let the rest unfold in its own time.</p>
            <a class="text-link" href="#home">Back to the beginning <span aria-hidden="true">↑</span></a>
        </div>
    </section>
</main>
